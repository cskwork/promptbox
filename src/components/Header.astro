---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base + '/';
---

<header class="sticky top-0 z-40 border-b border-white/50 bg-white/70 shadow-[0_1px_0_rgba(255,255,255,0.4)_inset,0_2px_12px_-6px_rgba(15,20,40,0.12)] backdrop-blur-[14px] backdrop-saturate-150 dark:border-white/5 dark:bg-ink-950/60">
  <div class="mx-auto flex h-14 max-w-8xl items-center justify-between px-4 lg:px-6">
    <a href={homeHref} class="flex items-center gap-2.5 font-mono font-semibold tracking-tight" aria-label="promptbox home" data-aria-en="promptbox home" data-aria-ko="promptbox 홈">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-accent-500/30 bg-accent-500/10 text-accent-600 dark:text-accent-400">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="5 8 9 12 5 16" />
          <line x1="11" y1="16" x2="17" y2="16" />
        </svg>
      </span>
      <span class="text-[0.98rem] text-ink-900 dark:text-ink-50">promptbox</span>
    </a>

    <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Primary" data-aria-en="Primary" data-aria-ko="주요">
      <a
        href={base + '/#how-it-works'}
        class="hidden items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm text-ink-600 transition-colors hover:bg-white/60 hover:text-accent-700 dark:text-ink-300 dark:hover:bg-ink-800/60 dark:hover:text-accent-400 sm:inline-flex"
      ><span data-lang="en">Guide</span><span data-lang="ko">사용법</span></a>
      <button
        id="pc-language-toggle"
        type="button"
        class="inline-flex h-9 min-w-9 items-center justify-center rounded-md px-2 font-mono text-xs font-semibold text-ink-600 transition-colors hover:bg-white/60 hover:text-accent-700 dark:text-ink-300 dark:hover:bg-ink-800/60 dark:hover:text-accent-400 lg:h-8"
        aria-label="한국어로 전환"
      >
        <span data-lang="en">KO</span><span data-lang="ko">EN</span>
      </button>
      <a
        href="https://github.com/cskwork/promptbox"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-600 lg:h-8 lg:w-8 transition-colors hover:bg-white/60 hover:text-accent-700 dark:text-ink-300 dark:hover:bg-ink-800/60 dark:hover:text-accent-400"
        target="_blank"
        rel="noopener"
        aria-label="GitHub repository (opens in a new tab)"
        data-aria-en="GitHub repository (opens in a new tab)"
        data-aria-ko="GitHub 저장소 (새 탭에서 열기)"
      >
        <svg class="h-[1.05rem] w-[1.05rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.73-1.34-1.73-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.3-5.47-1.31-5.47-5.81 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.51.12-3.15 0 0 1.01-.32 3.3 1.2.96-.26 1.98-.39 3-.4 1.02.01 2.04.14 3 .4 2.28-1.52 3.29-1.2 3.29-1.2.66 1.64.25 2.85.12 3.15.77.82 1.24 1.87 1.24 3.15 0 4.51-2.81 5.5-5.49 5.79.43.36.81 1.09.81 2.2 0 1.59-.01 2.87-.01 3.26 0 .31.21.68.83.56C20.57 21.91 24 17.5 24 12.29 24 5.78 18.63.5 12 .5z" />
        </svg>
      </a>
      <button
        id="pc-theme-toggle"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-600 lg:h-8 lg:w-8 transition-colors hover:bg-white/60 hover:text-accent-700 dark:text-ink-300 dark:hover:bg-ink-800/60 dark:hover:text-accent-400"
        aria-label="Toggle light or dark theme"
        data-aria-en="Toggle light or dark theme"
        data-aria-ko="밝은 테마 또는 어두운 테마로 전환"
        aria-pressed="false"
      >
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  const languageButton = document.getElementById('pc-language-toggle');
  const syncLanguage = () => {
    const korean = document.documentElement.lang === 'ko';
    if (languageButton) languageButton.setAttribute('aria-label', korean ? 'Switch to English' : '한국어로 전환');
    document.querySelectorAll('[data-aria-en]').forEach((element) => {
      const target = element;
      const label = korean ? target.getAttribute('data-aria-ko') : target.getAttribute('data-aria-en');
      if (label) target.setAttribute('aria-label', label);
    });
    const root = document.documentElement;
    document.title = (korean ? root.dataset.titleKo : root.dataset.titleEn) || document.title;
    const description = (korean ? root.dataset.descriptionKo : root.dataset.descriptionEn) || '';
    document.querySelectorAll('meta[name="description"], meta[property="og:description"], meta[name="twitter:description"]').forEach((meta) => {
      if (description) meta.setAttribute('content', description);
    });
    document.querySelectorAll('meta[property="og:title"], meta[name="twitter:title"]').forEach((meta) => {
      meta.setAttribute('content', document.title);
    });
    document.dispatchEvent(new CustomEvent('pc-language-change', { detail: { language: korean ? 'ko' : 'en' } }));
  };
  syncLanguage();
  languageButton?.addEventListener('click', () => {
    const root = document.documentElement;
    root.lang = root.lang === 'ko' ? 'en' : 'ko';
    localStorage.setItem('pc-language', root.lang);
    syncLanguage();
  });

  // Theme init runs in <head> (BaseLayout); here we handle the toggle + ARIA state.
  const tbtn = document.getElementById('pc-theme-toggle');
  const syncPressed = () => tbtn && tbtn.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
  syncPressed();
  tbtn?.addEventListener('click', () => {
    const root = document.documentElement;
    root.classList.toggle('dark');
    localStorage.setItem('pc-theme', root.classList.contains('dark') ? 'dark' : 'light');
    syncPressed();
  });
</script>
