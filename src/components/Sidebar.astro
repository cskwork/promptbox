---
import CategoryIcon from '~/components/CategoryIcon.astro';
import { CATEGORY_META, CATEGORY_ORDER, type CategoryKey } from '~/content/config';

interface NavItem {
  slug: string;
  title: string;
  titleEn?: string;
  category: CategoryKey;
  href: string;
  order: number;
  keywords: string;
}
interface Props { items: NavItem[]; currentHref?: string }
const { items, currentHref } = Astro.props;
const grouped = CATEGORY_ORDER.map(key => ({
  key,
  meta: CATEGORY_META[key],
  entries: items.filter(it => it.category === key).sort((a, b) => a.title.localeCompare(b.title, 'ko')),
}));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base + '/';
---

<aside class="site-sidebar">
  {currentHref !== homeHref && <div class="relative">
    <label for="pc-search" class="sr-only"><span data-lang="en">Search titles, summaries, and tags</span><span data-lang="ko">제목·요약·태그로 검색</span></label>
    <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-500 dark:text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
    <input type="search" id="pc-search" placeholder="Find an item…" data-placeholder-en="Find an item…" data-placeholder-ko="항목 검색…" class="glass-input w-full rounded-lg py-2.5 pl-9 pr-8 text-sm" autocomplete="off" />
    <kbd class="pc-kbd pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">/</kbd>
  </div>}
  <button id="pc-nav-toggle" type="button" aria-expanded="false" aria-controls="pc-nav-body" class="nav-toggle">
    <span data-lang="en">Browse categories</span><span data-lang="ko">카테고리 둘러보기</span>
    <svg class="pc-nav-chev h-4 w-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <div id="pc-nav-body">
    <p id="pc-search-count" class="mb-3 mt-4 hidden text-sm text-ink-500 dark:text-ink-400" role="status" aria-live="polite"></p>
    <nav class="mt-5 space-y-1 text-sm" aria-label="Catalog" data-aria-en="Catalog" data-aria-ko="카탈로그">
      <a href={homeHref + '#catalog'} aria-current={currentHref === homeHref ? 'page' : undefined} class:list={['nav-home', currentHref === homeHref && 'is-current']}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
        <span data-lang="en">All items</span><span data-lang="ko">전체 카탈로그</span>
        <span class="ml-auto tabular-nums">{items.length}</span>
      </a>
      {grouped.filter(group => group.entries.length).map(group => (
        <details data-pc-group={group.key} class:list={['nav-category', `cat-${group.key}`]} open={group.entries.some(entry => entry.href === currentHref)}>
          <summary>
            <span class="cat-tile h-6 w-6 shrink-0"><CategoryIcon icon={group.meta.icon} class="h-3.5 w-3.5" /></span>
            <span class="font-medium"><span data-lang="en">{group.meta.label_en}</span><span data-lang="ko">{group.meta.label}</span></span>
            <span class="ml-auto text-xs tabular-nums text-ink-500 dark:text-ink-400">{group.entries.length}</span>
            <svg class="nav-category-chevron h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </summary>
          <ul class="nav-entries">
            {group.entries.map(entry => (
              <li>
                <a href={entry.href} data-pc-item data-pc-keywords={entry.keywords} aria-current={entry.href === currentHref ? 'page' : undefined} class:list={['nav-entry', entry.href === currentHref && 'is-current']}>
                  <span data-lang="en">{entry.titleEn || entry.title}</span><span data-lang="ko">{entry.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
      <p id="pc-noresults" class="hidden px-2 py-4 text-sm text-ink-500 dark:text-ink-400"><span data-lang="en">No matches. Try another keyword.</span><span data-lang="ko">검색 결과가 없습니다. 다른 키워드를 입력해 보세요.</span></p>
    </nav>
    <nav class="sidebar-help" aria-label="Getting started" data-aria-en="Getting started" data-aria-ko="시작하기">
      <a href={homeHref + '#how-it-works'}><span data-lang="en">How to use promptbox</span><span data-lang="ko">promptbox 사용법</span></a>
      <a href={homeHref + '#start-here'}><span data-lang="en">Developer starter kit</span><span data-lang="ko">개발자 스타터 키트</span></a>
      <a href={base + '/tips/'}><span data-lang="en">Setup guide</span><span data-lang="ko">설치 가이드</span></a>
    </nav>
  </div>
</aside>

<script>
  import { initCatalogSearch } from '~/scripts/catalog-search';
  initCatalogSearch();
</script>
