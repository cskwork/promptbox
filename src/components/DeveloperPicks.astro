---
import CopyButton from '~/components/CopyButton.astro';
import { getCollection } from 'astro:content';
import { ONBOARDING_PICKS, INSTALL_PROMPT } from '~/data/onboarding';
import type { CategoryKey } from '~/content/config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Resolve each pick to its content entry. Cache one getCollection() call per category,
// skip any pick that goes missing/hidden so the section degrades instead of erroring.
const cols = new Map<CategoryKey, any[]>();
async function entriesFor(cat: CategoryKey) {
  if (!cols.has(cat)) cols.set(cat, await getCollection(cat, (e: any) => !e.data.hidden));
  return cols.get(cat)!;
}
const picks = (
  await Promise.all(
    ONBOARDING_PICKS.map(async ({ category, slug }) => {
      const entry = (await entriesFor(category)).find((e: any) => e.slug === slug);
      return entry ? { entry, category } : null;
    }),
  )
).filter(Boolean) as { entry: any; category: CategoryKey }[];

const promptHref = `${base}/prompts/agents-quick-onboarding/`;

const does = [
  { ko: 'pi가 없으면 설치, 있으면 최신 버전으로 업데이트', en: 'Installs pi or updates it to the latest release' },
  { ko: 'Impeccable을 포함한 pi 기본 스킬·설정 동기화', en: 'Syncs the pi setup, including Impeccable' },
  { ko: '공통 AGENTS.md를 설치된 코딩 에이전트에 연결', en: 'Shares one AGENTS.md across installed coding agents' },
];
---
<section id="start-here" class="scroll-mt-20 py-6">
  <div class="glass-panel rounded-2xl p-6 lg:p-8">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-ink-50"><span data-lang="en">Developer picks — start here</span><span data-lang="ko">개발자 추천 — 여기서 시작</span></h2>
        <p class="mt-1 text-sm text-ink-500 dark:text-ink-400"><span data-lang="en">One prompt to install or update pi and restore its default setup.</span><span data-lang="ko">프롬프트 하나로 pi 설치·업데이트와 기본 환경 구성을 함께 진행합니다.</span></p>
      </div>

    </div>

    <p class="mb-5 max-w-3xl text-pretty leading-relaxed text-ink-600 dark:text-ink-300">
      <span data-lang="en"><strong class="font-semibold text-ink-800 dark:text-ink-100">Paste the prompt below</strong> into an existing coding agent.
      It installs pi if needed or updates it to the latest release, then syncs the default settings and skills, including Impeccable, from pi-setup-public.
      The current AGENTS.md from <a href={`${base}/configs/the-system-prompt/`} class="font-medium underline underline-offset-2">cskwork/THE-SYSTEM-PROMPT</a> is also linked to your installed coding agents.</span>
      <span data-lang="ko">사용 중인 코딩 에이전트 채팅창에 아래 프롬프트를 <strong class="font-semibold text-ink-800 dark:text-ink-100">그대로 붙여넣으세요.</strong>
      pi가 없으면 설치하고, 이미 있으면 최신 버전으로 업데이트합니다. 이어서 pi-setup-public의 기본 설정과 Impeccable을 포함한 스킬을 동기화하고,
      <a href={`${base}/configs/the-system-prompt/`} class="font-medium underline underline-offset-2">cskwork/THE-SYSTEM-PROMPT</a>의 최신 AGENTS.md 원문을 설치된 코딩 에이전트에 연결합니다.</span>
    </p>

    <!-- One-shot install prompt: the <pre> is the copy target (button grabs its innerText). -->
    <div class="mb-5 overflow-hidden rounded-xl border border-ink-800/70 bg-ink-950 shadow-sm">
      <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-2">
        <span class="font-mono text-[0.7rem] uppercase tracking-wider text-ink-400"><span data-lang="en">Paste into your agent</span><span data-lang="ko">한 방 설치 프롬프트</span></span>
        <CopyButton target="#onboard-prompt" labelEn="Copy prompt" labelKo="프롬프트 복사" size="sm" />
      </div>
      <details class="text-ink-100"><summary class="cursor-pointer px-4 py-3 text-sm text-ink-300"><span data-lang="en">Read installation prompt</span><span data-lang="ko">설치 프롬프트 읽기</span></summary>
      <pre id="onboard-prompt" tabindex="0" class="max-h-80 overflow-auto px-4 py-3 font-mono text-[0.78rem] leading-relaxed text-ink-100">{INSTALL_PROMPT}</pre>
      </details>
    </div>

    <div class="mb-6 grid gap-2 sm:grid-cols-3">
      {does.map((d) => (
        <div class="flex items-start gap-2 rounded-lg border border-ink-100/80 bg-white/50 px-3 py-2 dark:border-white/10 dark:bg-ink-900/40">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-700 dark:text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="text-sm leading-snug text-ink-700 dark:text-ink-200"><span data-lang="en">{d.en}</span><span data-lang="ko">{d.ko}</span></span>
        </div>
      ))}
    </div>

    <div class="mb-3 flex flex-wrap items-baseline gap-x-2">
      <h3 class="text-sm font-semibold text-ink-800 dark:text-ink-100"><span data-lang="en">Related starter tools</span><span data-lang="ko">함께 살펴볼 도구</span></h3>
      <span class="font-mono text-[0.72rem] text-ink-500 dark:text-ink-400"><span data-lang="en">{picks.length} items</span><span data-lang="ko">{picks.length}개 항목</span></span>
      <a href={promptHref} class="ml-auto font-mono text-[0.72rem] text-accent-700 hover:underline dark:text-accent-400"><span data-lang="en">Installation prompt details →</span><span data-lang="ko">설치 프롬프트 자세히 →</span></a>
    </div>

    <ul class="grid gap-x-6 sm:grid-cols-2">
      {picks.map(({ entry, category }) => (
        <li class="border-b border-ink-200/60 dark:border-white/10">
          <a href={`${base}/${category}/${entry.slug}/`} class="flex min-h-11 items-center justify-between gap-3 py-2 text-sm text-ink-700 hover:text-accent-700 dark:text-ink-200 dark:hover:text-accent-400">
            <span class="min-w-0 break-words"><span data-lang="en">{entry.data.title_en || entry.data.title}</span><span data-lang="ko">{entry.data.title}</span></span>
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
