---
interface Props {
  target: string;
  label?: string;
  size?: 'sm' | 'md';
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { target, label = '복사', size = 'sm', variant = 'primary', class: className = '' } = Astro.props;

const sizes = {
  sm: 'px-2.5 py-1 text-xs',
  md: 'px-3.5 py-1.5 text-sm',
};
const variants = {
  primary: 'btn-primary',
  ghost: 'btn-ghost',
};
---
<button
  type="button"
  class:list={['btn pc-copy', sizes[size], variants[variant], className]}
  data-target={target}
  aria-label={label}
>
  <svg class="pc-ico-copy h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
  </svg>
  <svg class="pc-ico-check hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="20 6 9 17 4 12" />
  </svg>
  <span class="pc-copy-label">{label}</span>
</button>
