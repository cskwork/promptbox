---
import CategoryIcon from '~/components/CategoryIcon.astro';
import { CATEGORY_META, type CategoryKey } from '~/content/config';

interface Props {
  href: string;
  title: string;
  titleEn?: string;
  summary: string;
  summaryEn?: string;
  tags?: string[];
  source?: string;
  category: CategoryKey;
  catalogItem?: boolean;
}
const { href, title, titleEn, summary, summaryEn, tags = [], source, category, catalogItem = false } = Astro.props;
const meta = CATEGORY_META[category];

let sourceLabel: string | null = null;
if (source) {
  try {
    const u = new URL(source);
    sourceLabel = u.hostname.replace(/^www\./, '') + u.pathname.replace(/\/$/, '');
  } catch {
    sourceLabel = source;
  }
}
---
<article class:list={['group glass-card catalog-card flex flex-col rounded-xl h-full', `cat-${category}`]} data-catalog-item={catalogItem ? href : undefined}>
  <a href={href} class="card-main flex-1 flex flex-col p-5">
    <div class="mb-2.5 flex items-center gap-2">
      <span class="cat-tile h-7 w-7"><CategoryIcon icon={meta.icon} class="h-4 w-4" /></span>
      <span class="font-mono text-[0.7rem] font-semibold uppercase tracking-[0.12em]" style="color:var(--cat-text)">{meta.label_en}</span>
    </div>
    <h4 class="mb-2 text-base font-semibold leading-snug text-ink-900 transition-colors group-hover:text-accent-700 dark:text-ink-50 dark:group-hover:text-accent-400"><span data-lang="en">{titleEn || title}</span><span data-lang="ko">{title}</span></h4>
    <p class="line-clamp-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
      <span data-lang="en">{summaryEn || summary}</span><span data-lang="ko">{summary}</span>
    </p>
    {tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1 pt-3">
        {tags.slice(0, 4).map((t) => (
          <span class="card-tag">#{t}</span>
        ))}
      </div>
    )}
  </a>
  {source && (
    <a
      href={source}
      target="_blank"
      rel="noopener noreferrer"
      class="card-source flex items-center gap-1.5 rounded-b-xl border-t border-ink-100/80 bg-ink-50/40 px-4 py-2 text-xs text-ink-500 transition-colors hover:bg-ink-50/80 hover:text-accent-700 dark:border-white/5 dark:bg-ink-950/30 dark:hover:bg-ink-950/50 dark:hover:text-accent-400 dark:text-ink-400"
      aria-label={`${titleEn || title} — original source (opens in a new tab)`}
      data-aria-en={`${titleEn || title} — original source (opens in a new tab)`}
      data-aria-ko={`${title} — 원본 소스 (새 탭에서 열기)`}
    >
      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
      <span class="truncate">{sourceLabel}</span>
    </a>
  )}
</article>
