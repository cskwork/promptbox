        <CopyButton target="#tip-packages" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-ink-200/70 text-ink-700 dark:border-ink-700/60 dark:text-ink-200">
