        <CopyButton target="#tip-model-check" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-ink-200/70 text-ink-700 dark:border-ink-700/60 dark:text-ink-200">
              <th class="py-2 pr-3 font-semibold"><span data-lang="en">Model</span><span data-lang="ko">모델</span></th>
              <th class="py-2 pr-3 font-semibold"><span data-lang="en">Context</span><span data-lang="ko">컨텍스트</span></th>
              <th class="py-2 font-semibold"><span data-lang="en">Use it for</span><span data-lang="ko">쓰임새</span></th>
            </tr>
          </thead>
          <tbody class="text-ink-600 dark:text-ink-300">
            <tr class="border-b border-ink-200/50 dark:border-ink-800/60">
