---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, type CategoryKey } from '~/content/config';

const COLLECTIONS: CategoryKey[] = ['prompts', 'skills', 'plugins', 'configs', 'mcps'];
const lists = await Promise.all(COLLECTIONS.map((c) => getCollection(c, (e: any) => !e.data.hidden)));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const grouped = COLLECTIONS.map((key, idx) => ({
  key,
  meta: CATEGORY_META[key],
  entries: lists[idx].sort((a: any, b: any) => (a.data.order ?? 100) - (b.data.order ?? 100)),
}));

const total = grouped.reduce((acc, g) => acc + g.entries.length, 0);
const currentHref = base + '/';
---

<BaseLayout title="prompt-collection" currentHref={currentHref}>
  <section class="mb-10">
    <h1 class="text-3xl lg:text-4xl font-bold tracking-tight mb-3">자주 쓰는 프롬프트·스킬·MCP</h1>
    <p class="text-ink-600 dark:text-ink-300 max-w-2xl">
      복사해서 바로 붙여 쓰는 컬렉션. 좌측에서 카테고리를 선택하거나 아래 카드를 눌러 상세 페이지로 이동하세요.
      현재 총 <span class="font-semibold text-ink-900 dark:text-ink-100">{total}</span>개 항목.
    </p>
  </section>

  {grouped.map((group) => (
    <section class="mb-10" id={group.key}>
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-xl font-semibold">{group.meta.label}</h2>
        <span class="text-xs text-ink-500">{group.meta.description}</span>
      </div>
      {group.entries.length === 0 ? (
        <p class="text-sm text-ink-500 italic">아직 항목이 없습니다.</p>
      ) : (
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {group.entries.map((entry: any) => {
            const detailHref = `${base}/${group.key}/${entry.slug}/`;
            const source = entry.data.source as string | undefined;
            let sourceLabel: string | null = null;
            if (source) {
              try {
                const u = new URL(source);
                sourceLabel = u.hostname.replace(/^www\./, '') + u.pathname.replace(/\/$/, '');
              } catch {
                sourceLabel = source;
              }
            }
            return (
              <article class="group flex flex-col rounded-lg border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 hover:border-accent-500 hover:shadow-sm transition overflow-hidden">
                <a href={detailHref} class="flex-1 block p-4">
                  <h3 class="font-semibold text-ink-900 dark:text-ink-50 group-hover:text-accent-500 mb-1.5">{entry.data.title}</h3>
                  <p class="text-sm text-ink-600 dark:text-ink-300 line-clamp-2">{entry.data.summary}</p>
                  {entry.data.tags?.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1">
                      {entry.data.tags.slice(0, 4).map((t: string) => (
                        <span class="text-[0.7rem] rounded-full bg-ink-100 dark:bg-ink-800 px-2 py-0.5 text-ink-600 dark:text-ink-300">#{t}</span>
                      ))}
                    </div>
                  )}
                </a>
                {source && (
                  <a
                    href={source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 border-t border-ink-200 dark:border-ink-800 px-4 py-2 text-xs text-ink-500 hover:bg-ink-50 dark:hover:bg-ink-950 hover:text-accent-500 transition"
                    aria-label={`${entry.data.title} 원본 보기`}
                  >
                    <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                    <span class="truncate">{sourceLabel}</span>
                  </a>
                )}
              </article>
            );
          })}
        </div>
      )}
    </section>
  ))}
</BaseLayout>
