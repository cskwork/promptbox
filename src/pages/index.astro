---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, type CategoryKey } from '~/content/config';

const COLLECTIONS: CategoryKey[] = ['prompts', 'skills', 'configs', 'mcps'];
const lists = await Promise.all(COLLECTIONS.map((c) => getCollection(c, (e: any) => !e.data.hidden)));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const grouped = COLLECTIONS.map((key, idx) => ({
  key,
  meta: CATEGORY_META[key],
  entries: lists[idx].sort((a: any, b: any) => (a.data.order ?? 100) - (b.data.order ?? 100)),
}));

const total = grouped.reduce((acc, g) => acc + g.entries.length, 0);
const currentHref = base + '/';
---

<BaseLayout title="prompt-collection" currentHref={currentHref}>
  <section class="mb-10">
    <h1 class="text-3xl lg:text-4xl font-bold tracking-tight mb-3">자주 쓰는 프롬프트·스킬·MCP</h1>
    <p class="text-ink-600 dark:text-ink-300 max-w-2xl">
      복사해서 바로 붙여 쓰는 컬렉션. 좌측에서 카테고리를 선택하거나 아래 카드를 눌러 상세 페이지로 이동하세요.
      현재 총 <span class="font-semibold text-ink-900 dark:text-ink-100">{total}</span>개 항목.
    </p>
  </section>

  {grouped.map((group) => (
    <section class="mb-10" id={group.key}>
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-xl font-semibold">{group.meta.label}</h2>
        <span class="text-xs text-ink-500">{group.meta.description}</span>
      </div>
      {group.entries.length === 0 ? (
        <p class="text-sm text-ink-500 italic">아직 항목이 없습니다.</p>
      ) : (
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {group.entries.map((entry: any) => (
            <a
              href={`${base}/${group.key}/${entry.slug}/`}
              class="group block rounded-lg border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 p-4 hover:border-accent-500 hover:shadow-sm transition"
            >
              <div class="flex items-start justify-between gap-2 mb-1.5">
                <h3 class="font-semibold text-ink-900 dark:text-ink-50 group-hover:text-accent-500">{entry.data.title}</h3>
              </div>
              <p class="text-sm text-ink-600 dark:text-ink-300 line-clamp-2">{entry.data.summary}</p>
              {entry.data.tags?.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1">
                  {entry.data.tags.slice(0, 4).map((t: string) => (
                    <span class="text-[0.7rem] rounded-full bg-ink-100 dark:bg-ink-800 px-2 py-0.5 text-ink-600 dark:text-ink-300">#{t}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </section>
  ))}
</BaseLayout>
