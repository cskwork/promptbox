---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CopyButton from '~/components/CopyButton.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, type CategoryKey } from '~/content/config';

export async function getStaticPaths() {
  const cats: CategoryKey[] = ['prompts', 'skills', 'configs', 'mcps'];
  const all = await Promise.all(
    cats.map(async (cat) => {
      const entries = await getCollection(cat);
      return entries.map((entry: any) => ({
        params: { category: cat, slug: entry.slug },
        props: { entry, category: cat },
      }));
    }),
  );
  return all.flat();
}

const { entry, category } = Astro.props as { entry: any; category: CategoryKey };
const { Content } = await entry.render();
const meta = CATEGORY_META[category];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentHref = `${base}/${category}/${entry.slug}/`;
const rawText = entry.body || '';
---

<BaseLayout title={`${entry.data.title} — prompt-collection`} description={entry.data.summary} currentHref={currentHref}>
  <nav class="mb-4 text-sm text-ink-500">
    <a href={base + '/'} class="hover:text-accent-500">홈</a>
    <span class="mx-1.5">›</span>
    <a href={`${base}/#${category}`} class="hover:text-accent-500">{meta.label}</a>
    <span class="mx-1.5">›</span>
    <span class="text-ink-700 dark:text-ink-200">{entry.data.title}</span>
  </nav>

  <header class="mb-6">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
      <h1 class="text-2xl lg:text-3xl font-bold tracking-tight">{entry.data.title}</h1>
      <div class="flex items-center gap-2">
        <CopyButton target="#pc-rawtext" label="원문 복사" size="md" />
        {entry.data.source && (
          <a
            href={entry.data.source}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm bg-ink-100 hover:bg-ink-200 dark:bg-ink-800 dark:hover:bg-ink-700 text-ink-800 dark:text-ink-100"
          >원본 보기</a>
        )}
      </div>
    </div>
    <p class="text-ink-600 dark:text-ink-300">{entry.data.summary}</p>
    <dl class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
      {entry.data.author && (
        <div>
          <dt class="text-ink-500">작성자</dt>
          <dd class="font-medium text-ink-800 dark:text-ink-100">{entry.data.author}</dd>
        </div>
      )}
      {entry.data.license && (
        <div>
          <dt class="text-ink-500">라이선스</dt>
          <dd class="font-medium text-ink-800 dark:text-ink-100">{entry.data.license}</dd>
        </div>
      )}
      {entry.data.target_file && (
        <div>
          <dt class="text-ink-500">파일 경로</dt>
          <dd class="font-mono text-ink-800 dark:text-ink-100">{entry.data.target_file}</dd>
        </div>
      )}
      {entry.data.trigger && (
        <div class="col-span-2 sm:col-span-2">
          <dt class="text-ink-500">트리거</dt>
          <dd class="text-ink-800 dark:text-ink-100">{entry.data.trigger}</dd>
        </div>
      )}
    </dl>
    {entry.data.tags?.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1">
        {entry.data.tags.map((t: string) => (
          <span class="text-[0.7rem] rounded-full bg-ink-100 dark:bg-ink-800 px-2 py-0.5 text-ink-600 dark:text-ink-300">#{t}</span>
        ))}
      </div>
    )}
  </header>

  <article class="prose-pc">
    <Content />
  </article>

  <!-- Hidden raw text mirror for "원문 복사" button -->
  <pre id="pc-rawtext" class="sr-only" set:text={rawText}></pre>
</BaseLayout>
