---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CopyButton from '~/components/CopyButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentHref = `${base}/tips/`;

// ── 검증된 명령 (2026-08-19 실측) ──
const cmdNodeCheck = `node -v    # v22 이상이면 OK. 아무 출력이 없으면 아래로`;
const cmdNodeInstall = `# macOS (nvm 권장):
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
# 터미널 재시작 후:
nvm install 22 && nvm use 22

# Windows: https://nodejs.org 에서 LTS 인스톨러 설치`;
const cmdInstall = `npm install -g @opencode-ai/cli@beta    # 설치되는 명령 이름은 opencode2`;
const cmdVerify = `opencode2 --version`;
const cmdInstallV1 = `# 예전 안정판(v1)을 쓰려면 — 명령 이름은 opencode
curl -fsSL https://opencode.ai/install | bash
npm install -g opencode-ai@latest   # 같은 것, Windows는 이쪽`;
const cmdOmoInstall = `bunx oh-my-opencode-slim@latest install

# Bun이 없으면 npx도 같다:
npx oh-my-opencode-slim@latest install`;
const cmdOmoV2 = `# opencode2는 설정 디렉터리가 따로다 — ~/.config/opencode2/opencode.json 에 아래를 넣는다.
# 파일이 이미 있으면 plugin 배열만 합칠 것.
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode-slim@latest"]
}`;
const cmdAuth = `opencode2 auth login    # 목록에서 zai-coding-plan 선택 → 키 붙여넣기`;
const cmdModels = `opencode2 models | grep zai-coding-plan    # 내 구독으로 열리는 모델 확인`;
const cmdPresetOpen = `# macOS / Linux
open ~/.config/opencode/oh-my-opencode-slim.json

# 또는 에디터로
code ~/.config/opencode/oh-my-opencode-slim.json`;
const cmdPreset = `{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "glm",
  "presets": {
    "glm": {
      "orchestrator": { "model": "zai-coding-plan/glm-5.3", "skills": ["*"], "mcps": ["*"] },
      "oracle":       { "model": "zai-coding-plan/glm-5.3", "skills": [], "mcps": [] },
      "librarian":    { "model": "zai-coding-plan/glm-5-turbo", "skills": [], "mcps": ["context7"] },
      "explorer":     { "model": "zai-coding-plan/glm-5-turbo", "skills": [], "mcps": [] },
      "designer":     { "model": "zai-coding-plan/glm-5.3", "skills": [], "mcps": [] },
      "fixer":        { "model": "zai-coding-plan/glm-5.3", "skills": [], "mcps": [] }
    }
  }
}`;
const cmdVisionMcp = `// ~/.config/opencode2/opencode.json  (v1이면 ~/.config/opencode/opencode.json)
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server@latest"],
      "environment": {
        "Z_AI_API_KEY": "여기에_코딩플랜_키_붙여넣기",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}`;
const cmdVisionAgent = `// ~/.config/opencode/oh-my-opencode-slim.json — 눈이 필요한 에이전트에만 붙인다
{
  "presets": {
    "glm": {
      "designer":     { "model": "zai-coding-plan/glm-5.3", "skills": [], "mcps": ["zai-mcp-server"] },
      "orchestrator": { "model": "zai-coding-plan/glm-5.3", "skills": ["*"], "mcps": ["*"] }
    }
  }
}`;
const cmdRun = `cd ~/my-project     # 작업할 폴더로 이동
opencode2           # 실행`;
const cmdFirst = `이 폴더의 코드를 읽고 프로젝트 구조를 요약해줘`;
const cmdVisionInstall = `git clone https://github.com/cskwork/promptbox ~/promptbox
ln -s ~/promptbox/plugins/glm-vision ~/.agents/skills/glm-vision`;
const cmdVisionUse = `python3 ~/.agents/skills/glm-vision/glm_vision.py 이미지.png -q "이 이미지의 오류 메시지를 그대로 읽어줘"`;
const cmdPrimeInstall = `curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh | sh
# 또는: npm install -g prime-agent   (Node 22.8 이상)

cd ~/my-project && prime-agent
# 에이전트 안에서: /login → ZAI 선택 → 키 붙여넣기`;
---

<BaseLayout
  title="Tips & Tricks — promptbox"
  titleKo="Tips & Tricks — promptbox"
  description="Zero-to-hero beginner tutorial in Korean: get your Z.ai GLM key, install OpenCode and oh-my-opencode-slim, wire up GLM-5.3, and run your first agent team session."
  descriptionKo="완전 입문자용 튜토리얼: Z.ai GLM API 키 발급부터 OpenCode + oh-my-opencode-slim 설치, GLM-5.3 연결, 첫 세션까지 단계별로."
  currentHref={currentHref}
>
  <nav class="mb-4 flex items-center gap-1.5 text-sm text-ink-500" aria-label="Breadcrumb" data-aria-en="Breadcrumb" data-aria-ko="경로">
    <a href={base + '/'} class="hover:text-accent-700 dark:hover:text-accent-400"><span data-lang="en">Home</span><span data-lang="ko">홈</span></a>
    <span aria-hidden="true">›</span>
    <span class="text-ink-700 dark:text-ink-200">Tips &amp; Tricks</span>
  </nav>

  <header class="glass-panel mb-6 rounded-2xl p-5 lg:p-6">
    <h1 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-ink-50 lg:text-3xl">
      <span data-lang="en">Tips &amp; Tricks — zero to coding agent</span>
      <span data-lang="ko">Tips &amp; Tricks — 코딩 에이전트 0에서 시작하기</span>
    </h1>
    <p class="mt-2 text-pretty leading-relaxed text-ink-600 dark:text-ink-300">
      <span data-lang="en">A step-by-step beginner tutorial: receive a Z.ai GLM key, install OpenCode 2, add the oh-my-opencode-slim agent team, point it at GLM-5.3, and run your first session. Every command was verified on a real machine (2026-08-19).</span>
      <span data-lang="ko">Z.ai GLM 키를 받는 순간부터 OpenCode 2를 설치하고, 에이전트 팀 플러그인(oh-my-opencode-slim)을 얹고, GLM-5.3에 연결해 첫 세션을 돌리기까지. 코딩 지식 없이 따라 할 수 있는 단계별 튜토리얼이며, 아래 모든 명령은 실제 머신에서 검증했다(2026-08-19).</span>
    </p>
    <p class="mt-3 rounded-lg border border-accent-500/30 bg-accent-500/10 px-3 py-2 text-sm text-ink-700 dark:text-ink-200">
      <span data-lang="en"><strong class="font-semibold">Default setup</strong>: <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href={`${base}/harnesses/opencode/`}>OpenCode 2</a> + <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href={`${base}/harnesses/oh-my-opencode-slim/`}>oh-my-opencode-slim</a> + <code class="font-mono text-[0.85em]">glm-5.3</code>. Prefer a single-agent harness? Prime Agent is at the bottom of this page.</span>
      <span data-lang="ko"><strong class="font-semibold">기본 구성</strong>은 <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href={`${base}/harnesses/opencode/`}>OpenCode 2</a> + <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href={`${base}/harnesses/oh-my-opencode-slim/`}>oh-my-opencode-slim</a> + <code class="font-mono text-[0.85em]">glm-5.3</code>이다. 에이전트 한 명짜리 단순한 구성을 원하면 이 페이지 맨 아래 Prime Agent를 보라.</span>
    </p>
  </header>

  <div class="space-y-6">

    <!-- STEP 0 -->
    <section class="glass-panel rounded-2xl p-5 lg:p-6">
      <div class="mb-2 flex items-baseline gap-2">
        <span class="font-mono text-sm font-bold text-accent-700 dark:text-accent-400">STEP 0</span>
        <h2 class="text-lg font-semibold text-ink-900 dark:text-ink-50"><span data-lang="en">Prepare a Z.ai API key</span><span data-lang="ko">준비물 — Z.ai API 키</span></h2>
      </div>
      <p class="text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">You need one Z.ai GLM key. Two ways to get it:</span>
        <span data-lang="ko">필요한 것은 딱 하나, Z.ai GLM 키다. 받는 방법은 두 가지다:</span>
      </p>
      <ul class="mt-2 list-disc space-y-1.5 pl-6 text-sm leading-relaxed text-ink-600 dark:text-ink-300 marker:text-accent-500">
        <li>
          <span data-lang="en"><strong class="font-semibold text-ink-800 dark:text-ink-100">Shared key from this console (recommended)</strong>: log in to the <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href="https://zai-coding-plan.vercel.app" target="_blank" rel="noopener">ZAI Plan Console</a> → 「API 키 금고」 → tap 「관리자에게 키 열람 요청」. Once the admin approves, the key appears in the vault — press 열람 to copy it.</span>
          <span data-lang="ko"><strong class="font-semibold text-ink-800 dark:text-ink-100">이 콘솔에서 공유받기(권장)</strong>: <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href="https://zai-coding-plan.vercel.app" target="_blank" rel="noopener">ZAI Plan Console</a>에 Google 로그인 → 「API 키 금고」 화면 → 「관리자에게 키 열람 요청」 버튼 누르기. 관리자가 승인하면 금고에 공유 키가 나타나고, 「열람」 버튼으로 복사할 수 있다.</span>
        </li>
        <li>
          <span data-lang="en"><strong class="font-semibold text-ink-800 dark:text-ink-100">Your own subscription</strong>: subscribe to the GLM Coding Plan at <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href="https://z.ai" target="_blank" rel="noopener">z.ai</a> and issue an API key from your dashboard.</span>
          <span data-lang="ko"><strong class="font-semibold text-ink-800 dark:text-ink-100">직접 구독</strong>: <a class="text-accent-700 dark:text-accent-400 font-medium underline underline-offset-2" href="https://z.ai" target="_blank" rel="noopener">z.ai</a>에서 GLM Coding Plan을 구독하고, 대시보드에서 API 키를 발급받는다.</span>
        </li>
      </ul>
      <p class="mt-2 rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-sm text-amber-800 dark:text-amber-200">
        <span data-lang="en">⚠ Treat the key like a password. Never paste it in chats or screenshots. If it leaks, ask for rotation immediately.</span>
        <span data-lang="ko">⚠ 키는 비밀번호다. 채팅·스크린샷에 절대 붙여넣지 말고, 유출되면 즉시 관리자에게 회전(교체)을 요청하라.</span>
      </p>
    </section>

    <!-- STEP 1 -->
    <section class="glass-panel rounded-2xl p-5 lg:p-6">
      <div class="mb-2 flex items-baseline gap-2">
        <span class="font-mono text-sm font-bold text-accent-700 dark:text-accent-400">STEP 1</span>
        <h2 class="text-lg font-semibold text-ink-900 dark:text-ink-50"><span data-lang="en">Open the terminal</span><span data-lang="ko">터미널 열기</span></h2>
      </div>
      <p class="text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">macOS: press <kbd class="rounded border border-ink-300 px-1 font-mono text-xs dark:border-ink-700">⌘+Space</kbd>, type <code class="font-mono text-[0.85em]">터미널</code> (or Terminal), Enter. Windows: press the Start key, type <code class="font-mono text-[0.85em]">PowerShell</code>, Enter.</span>
        <span data-lang="ko">macOS: <kbd class="rounded border border-ink-300 px-1 font-mono text-xs dark:border-ink-700">⌘+스페이스</kbd>를 누르고 <code class="font-mono text-[0.85em]">터미널</code>(또는 Terminal) 입력 후 엔터. Windows: 시작 버튼 → <code class="font-mono text-[0.85em]">PowerShell</code> 검색 → 엔터. 이후 모든 명령은 이 창에 입력한다.</span>
      </p>
    </section>

    <!-- STEP 2 -->
    <section class="glass-panel rounded-2xl p-5 lg:p-6">
      <div class="mb-2 flex items-baseline gap-2">
        <span class="font-mono text-sm font-bold text-accent-700 dark:text-accent-400">STEP 2</span>
        <h2 class="text-lg font-semibold text-ink-900 dark:text-ink-50"><span data-lang="en">Check Node.js (v22+)</span><span data-lang="ko">Node.js 확인 (v22 이상)</span></h2>
      </div>
      <p class="mb-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">Both the CLI (STEP 3) and the plugin installer (STEP 4) come through npm — <code class="font-mono text-[0.85em]">npm</code>, <code class="font-mono text-[0.85em]">npx</code>, or <code class="font-mono text-[0.85em]">bunx</code>. Check Node first:</span>
        <span data-lang="ko">CLI 설치(STEP 3)도, 플러그인 설치기(STEP 4)도 npm을 거친다 — <code class="font-mono text-[0.85em]">npm</code>·<code class="font-mono text-[0.85em]">npx</code>·<code class="font-mono text-[0.85em]">bunx</code>. 먼저 확인:</span>
      </p>
      <div class="mb-3 flex items-stretch gap-2">
        <code id="tip-node-check" class="min-w-0 flex-1 overflow-x-auto whitespace-pre rounded-lg border border-ink-800/70 bg-ink-950 px-3 py-2 font-mono text-[0.82rem] text-ink-100">{cmdNodeCheck}</code>
        <CopyButton target="#tip-node-check" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
      <p class="mb-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">If the version is older or the command is not found, install Node 22:</span>
        <span data-lang="ko">버전이 더 낮거나 명령이 없다고 나오면 Node 22을 설치한다:</span>
      </p>
      <div class="flex items-stretch gap-2">
        <code id="tip-node-install" class="min-w-0 flex-1 overflow-x-auto whitespace-pre rounded-lg border border-ink-800/70 bg-ink-950 px-3 py-2 font-mono text-[0.82rem] text-ink-100">{cmdNodeInstall}</code>
        <CopyButton target="#tip-node-install" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
    </section>

    <!-- STEP 3 -->
    <section class="glass-panel rounded-2xl p-5 lg:p-6">
      <div class="mb-2 flex items-baseline gap-2">
        <span class="font-mono text-sm font-bold text-accent-700 dark:text-accent-400">STEP 3</span>
        <h2 class="text-lg font-semibold text-ink-900 dark:text-ink-50"><span data-lang="en">Install OpenCode 2</span><span data-lang="ko">OpenCode 2 설치</span></h2>
      </div>
      <p class="mb-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">Install the v2 preview CLI. The npm package is <code class="font-mono text-[0.85em]">@opencode-ai/cli</code> on the <code class="font-mono text-[0.85em]">beta</code> tag, and the command it installs is <code class="font-mono text-[0.85em]">opencode2</code> — this is the build this guide was verified on:</span>
        <span data-lang="ko">v2 프리뷰 CLI를 설치한다. npm 패키지는 <code class="font-mono text-[0.85em]">@opencode-ai/cli</code>의 <code class="font-mono text-[0.85em]">beta</code> 태그이고, 설치되는 명령 이름은 <code class="font-mono text-[0.85em]">opencode2</code>다. 이 문서는 이 빌드에서 검증했다:</span>
      </p>
      <div class="mb-3 flex items-stretch gap-2">
        <code id="tip-install" class="min-w-0 flex-1 overflow-x-auto whitespace-pre rounded-lg border border-ink-800/70 bg-ink-950 px-3 py-2 font-mono text-[0.82rem] text-ink-100">{cmdInstall}</code>
        <CopyButton target="#tip-install" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
      <div class="mb-3 flex items-stretch gap-2">
        <code id="tip-verify" class="min-w-0 flex-1 overflow-x-auto whitespace-pre rounded-lg border border-ink-800/70 bg-ink-950 px-3 py-2 font-mono text-[0.82rem] text-ink-100">{cmdVerify}</code>
        <CopyButton target="#tip-verify" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
      <p class="mb-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">v2 is a preview build. If you want the stable v1 line instead, the package is <code class="font-mono text-[0.85em]">opencode-ai</code> and the command is <code class="font-mono text-[0.85em]">opencode</code> — every step below then drops the <code class="font-mono text-[0.85em]">2</code>:</span>
        <span data-lang="ko">v2는 프리뷰 빌드다. 안정판 v1 계열을 원하면 패키지는 <code class="font-mono text-[0.85em]">opencode-ai</code>, 명령은 <code class="font-mono text-[0.85em]">opencode</code>다. 그 경우 아래 모든 단계에서 <code class="font-mono text-[0.85em]">2</code>만 빼면 된다:</span>
      </p>
      <div class="flex items-stretch gap-2">
        <code id="tip-install-v1" class="min-w-0 flex-1 overflow-x-auto whitespace-pre rounded-lg border border-ink-800/70 bg-ink-950 px-3 py-2 font-mono text-[0.82rem] text-ink-100">{cmdInstallV1}</code>
        <CopyButton target="#tip-install-v1" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
    </section>

    <!-- STEP 4 -->
    <section class="glass-panel rounded-2xl p-5 lg:p-6">
      <div class="mb-2 flex items-baseline gap-2">
        <span class="font-mono text-sm font-bold text-accent-700 dark:text-accent-400">STEP 4</span>
        <h2 class="text-lg font-semibold text-ink-900 dark:text-ink-50"><span data-lang="en">Add the agent team (oh-my-opencode-slim)</span><span data-lang="ko">에이전트 팀 얹기 (oh-my-opencode-slim)</span></h2>
      </div>
      <p class="mb-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">This plugin turns one agent into a team of seven: an Orchestrator that plans and dispatches, plus Explorer (search), Oracle (deep review), Librarian (docs), Designer (UI), Fixer (implementation), and Council (multi-model vote). Specialists run as background tasks in parallel.</span>
        <span data-lang="ko">이 플러그인은 에이전트 한 명을 일곱 명 팀으로 바꾼다. 계획하고 일을 나눠주는 Orchestrator(지휘자) 아래에 Explorer(코드 탐색), Oracle(깊은 검토), Librarian(문서 조회), Designer(UI), Fixer(구현), Council(여러 모델 동시 판단)이 붙는다. 전문 에이전트는 background task(뒤에서 동시에 도는 작업)로 병렬 실행된다.</span>
      </p>
      <div class="mb-3 flex items-stretch gap-2">
        <code id="tip-omo-install" class="min-w-0 flex-1 overflow-x-auto whitespace-pre rounded-lg border border-ink-800/70 bg-ink-950 px-3 py-2 font-mono text-[0.82rem] text-ink-100">{cmdOmoInstall}</code>
        <CopyButton target="#tip-omo-install" labelEn="Copy" labelKo="복사" size="sm" variant="ghost" class="shrink-0" />
      </div>
      <p class="mb-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
        <span data-lang="en">The installer registers the plugin in <code class="font-mono text-[0.85em]">~/.config/opencode/opencode.json</code> and creates <code class="font-mono text-[0.85em]">~/.config/opencode/oh-my-opencode-slim.json</code>. It only generates <code class="font-mono text-[0.85em]">openai</code> and <code class="font-mono text-[0.85em]">opencode-go</code> presets — STEP 6 replaces that with a GLM one.</span>
