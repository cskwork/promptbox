---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Sidebar from '~/components/Sidebar.astro';
import Footer from '~/components/Footer.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_ORDER, type CategoryKey } from '~/content/config';

interface Props {
  title: string;
  titleKo?: string;
  description?: string;
  descriptionKo?: string;
  currentHref?: string;
}
const {
  title,
  titleKo = title,
  description = 'A curated, copy-paste toolbox of prompts, skills, hooks, configs, and more for AI coding agents.',
  descriptionKo = description,
  currentHref,
} = Astro.props;

const COLLECTIONS: CategoryKey[] = [...CATEGORY_ORDER];
const lists = await Promise.all(COLLECTIONS.map((c) => getCollection(c, (e: any) => !e.data.hidden)));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : `${base}/og.png`;
const items = lists.flatMap((entries, idx) => {
  const category = COLLECTIONS[idx];
  return entries.map((entry: any) => ({
    slug: entry.slug,
    title: entry.data.title,
    titleEn: entry.data.title_en,
    category,
    order: entry.data.order ?? 100,
    href: `${base}/${category}/${entry.slug}/`,
    keywords: [entry.data.title, entry.data.title_en, entry.data.summary, entry.data.summary_en, ...(entry.data.tags ?? [])]
      .filter(Boolean)
      .join(' ')
      .toLowerCase(),
  }));
});
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth"
  data-title-en={title}
  data-title-ko={titleKo}
  data-description-en={description}
  data-description-ko={descriptionKo}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070912" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="promptbox" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Self-hosted variable fonts (latin subset): no third-party render-blocking
        request, no external origin handshakes. Preload + swap so text paints fast. */}
    <link rel="preload" href={`${base}/fonts/geist-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/jetbrains-mono-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`
      @font-face{font-family:'Geist Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${base}/fonts/geist-variable-latin.woff2) format('woff2-variations')}
      @font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${base}/fonts/jetbrains-mono-variable-latin.woff2) format('woff2-variations')}
    `}></style>
    <script is:inline>
      // Mark JS available and apply saved preferences before paint.
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        const language = localStorage.getItem('pc-language');
        if (language === 'ko') root.lang = 'ko';
        const saved = localStorage.getItem('pc-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) root.classList.add('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="skip-link btn btn-primary px-4 py-2 text-sm">
      <span data-lang="en">Skip to content</span><span data-lang="ko">본문으로 건너뛰기</span>
    </a>
    <Header />
    <div class="mx-auto flex max-w-8xl flex-col lg:flex-row">
      <Sidebar items={items} currentHref={currentHref} />
      <main id="main" tabindex="-1" class="min-w-0 flex-1 px-4 py-8 focus:outline-none lg:px-10">
        <slot />
      </main>
    </div>
    <Footer />

    <script>
      // Copy-to-clipboard for any [data-target] button with class "pc-copy"
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pc-copy');
        if (!btn) return;
        // Two ways to name what gets copied:
        //  - data-target="#sel": a fixed element anywhere on the page
        //  - data-copy-next: the first <pre> that follows the button's block,
        //    used by in-prose CTAs that must copy only the code block they
        //    introduce (not the whole entry).
        let el: HTMLElement | null = null;
        if (btn.dataset.copyNext !== undefined) {
          let node = (btn.closest('.copy-cta') ?? btn).nextElementSibling;
          while (node && node.tagName !== 'PRE') node = node.nextElementSibling;
          el = node as HTMLElement | null;
        } else if (btn.dataset.target) {
          el = document.querySelector(btn.dataset.target) as HTMLElement | null;
        }
        if (!el) return;
        const text = (el as HTMLElement).innerText;
        const labelEl = btn.querySelector('.pc-copy-label');
        const copyIco = btn.querySelector('.pc-ico-copy');
        const checkIco = btn.querySelector('.pc-ico-check');
        try {
          await navigator.clipboard.writeText(text);
          const prev = labelEl?.innerHTML ?? 'Copy';
          if (labelEl) labelEl.textContent = document.documentElement.lang === 'ko' ? '복사됨' : 'Copied';
          copyIco?.classList.add('hidden');
          checkIco?.classList.remove('hidden');
          window.setTimeout(() => {
            if (labelEl) labelEl.innerHTML = prev;
            copyIco?.classList.remove('hidden');
            checkIco?.classList.add('hidden');
          }, 1500);
        } catch {
          alert(document.documentElement.lang === 'ko'
            ? '클립보드 복사에 실패했습니다. 수동으로 복사해 주세요.'
            : 'Could not copy to the clipboard. Please copy it manually.');
        }
      });

      // Scroll reveal (respects prefers-reduced-motion via CSS)
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
